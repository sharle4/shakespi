[Unit]
Description=Shakespi - Headless English Learning Device
After=network.target sound.target

[Service]
Type=simple
User=shakespi
Group=shakespi
WorkingDirectory=/home/shakespi/shakespi
Environment="PATH=/home/shakespi/shakespi/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/shakespi/shakespi/venv/bin/python main.py
Restart=on-failure
RestartSec=5

# For sounddevice / ALSA access
SupplementaryGroups=audio

[Install]
WantedBy=multi-user.target
